
# The address shown on the beta landing page's Contact and Request beta access
# pages. Deliberately not hard-coded and deliberately without a default: an
# invented address produces a page that looks helpful and silently swallows
# every message sent to it. Unset, those pages say so plainly instead.
# VITE_CONTACT_EMAIL="you@your-domain.com"

# RevenueCat Web Billing - all four are PUBLIC and ship in the bundle. The
# key is the Web Billing public key: rcb_sb_... (sandbox) or rcb_... (live).
# Never the secret key. Unset, Settings > Subscription shows the plan but the
# paywall button is disabled.
# VITE_REVENUECAT_ENABLED=true
# VITE_REVENUECAT_PUBLIC_API_KEY=...
# VITE_REVENUECAT_ENTITLEMENT_ID=zugzwang_pro
# VITE_REVENUECAT_OFFERING_ID=default
