# Copy this file to .env and fill in your own values, then run: docker-compose up --build
GEMINI_API_KEY=your-gemini-api-key-here
# Use real, generated values - not admin/admin. Generate with:
#   openssl rand -base64 24   (password)
#   openssl rand -hex 24      (api key)
LANGFLOW_USERNAME=changeme_username
LANGFLOW_PASSWORD=changeme_password
LANGFLOW_API_KEY=changeme_api_key
# Cross-origin callers allowed to hit /api/*. Same-origin (nginx serving the
# frontend) needs nothing here; set it only if you host the frontend elsewhere.
# ALLOWED_ORIGINS=https://your-app.onrender.com
