# Copy this file to .env and fill in your own values, then run: docker-compose up --build
GEMINI_API_KEY=your-gemini-api-key-here
LANGFLOW_USERNAME=changeme_username
LANGFLOW_PASSWORD=changeme_password

# ---------------------------------------------------------------------------
# Accounts and persistent storage
# ---------------------------------------------------------------------------
# Neon Postgres. Use the POOLED endpoint (the host contains "-pooler"): this
# backend restarts, and direct connections would be left to time out against
# Neon's own limit rather than being reused. Quote it - the connection string
# contains "&", and .env is read by `set -a; . ./.env`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Signs the guest identity cookie. Without a stable value every restart
# invalidates every guest cookie and each visitor becomes a new guest, losing
# the thread between their games. Generate with: openssl rand -hex 32
SESSION_COOKIE_SECRET="changeme_openssl_rand_hex_32"

# How long an UNCLAIMED guest's history survives before the retention sweep
# deletes it. Claimed history belongs to an account and is never swept.
GUEST_RETENTION_DAYS=30

# Google sign-in. Absent = the feature is off, /api/auth/google/* answers 503,
# and /api/auth/config reports google:false so the UI draws no button.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://zugzwang-api.onrender.com/api/auth/google/callback
# FRONTEND_URL=https://chess-app-rho-swart.vercel.app

# ---------------------------------------------------------------------------
# Transactional email (Resend) - password reset
# ---------------------------------------------------------------------------
# Absent = email is off. /api/auth/forgot-password still answers identically
# (that is the point of it), it simply sends nothing. Never commit this.
RESEND_API_KEY="re_your_key_here"

# Must be an address on a domain verified in Resend, or Resend refuses the
# send with a 403. "Zugzwang <onboarding@resend.dev>" works without a domain
# but only delivers to the address that owns the Resend account - fine for a
# first test, useless for real users.
RESEND_FROM="Zugzwang <no-reply@your-verified-domain.com>"

# Where the reset link points. Must be the FRONTEND, not the API.
FRONTEND_URL="http://localhost:3001"

# Local development only: prints the reset link to the backend log so the flow
# can be walked without sending email. Ignored in production, and a reset link
# in a log is an account takeover for anyone who reads the log - leave it off
# unless you are actively testing.
# RESET_LINK_TO_LOG=true
