# Langflow service for the Render deployment.
#
# Render builds each service from a Dockerfile alone - no docker-compose, no
# bind mounts - so everything the local compose setup mounted at runtime has to
# be baked into the image here: the Chess flow definition and the startup
# script that imports it.
FROM langflowai/langflow:latest

USER root

# The flow the backend drives. Its Gemini key is a __GEMINI_API_KEY__
# placeholder in the committed JSON; the entrypoint substitutes the real value
# from the environment at boot, so no key is ever baked into this image.
COPY flows/Chess.json /app/flows-template/Chess.json

COPY langflow-entrypoint.sh /app/langflow-entrypoint.sh
RUN chmod +x /app/langflow-entrypoint.sh

# Render assigns the port via $PORT; the entrypoint falls back to 7860 locally.
EXPOSE 7860

ENTRYPOINT ["/app/langflow-entrypoint.sh"]
